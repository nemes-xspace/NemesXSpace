[Unit]
Description=NEMES Komuta API (testnet)
After=network.target beyin_bekci.service
Wants=beyin_bekci.service

[Service]
User=d3str0y1ng
WorkingDirectory=/home/d3str0y1ng/nemes-testnet
Environment=DB_PATH=/home/d3str0y1ng/nemes-testnet/komuta.db
Environment=GOREV_CORPUS=tr
Environment=PORT=8787
Environment=P2P_PORT=4003
Environment=EMBED_API=http://127.0.0.1:1241
Environment=RUST_LOG=info
ExecStart=/home/d3str0y1ng/nemes-testnet/bin/komuta-rs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
